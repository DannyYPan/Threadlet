<Window x:Class="Threadlet.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Threadlet" Width="1200" Height="800" MinWidth="900" MinHeight="620" Background="#171A27" FontFamily="Segoe UI" FontSize="14">
<Grid>
<Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
<Border Background="#1D2030" BorderBrush="#303347" BorderThickness="0,0,1,0"><Grid Margin="20">
<Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Grid Margin="0,8,0,24"><StackPanel><TextBlock Text="threadlet" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="A little closer, wherever you are." Foreground="#9298B3" FontSize="12" Margin="0,5,0,0"/></StackPanel></Grid>
<Grid Grid.Row="1" Margin="0,0,0,14"><TextBlock Text="Messages" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Content="+ New" HorizontalAlignment="Right" Click="NewChat_Click"/></Grid>
<TextBox Grid.Row="2" x:Name="Search" ToolTip="Search conversations" TextChanged="Search_Changed" Margin="0,0,0,14"/>
<ListBox Grid.Row="3" x:Name="Chats" SelectionChanged="Chat_Selected" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
<ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Width="38" Height="38" CornerRadius="19" Background="#595082" VerticalAlignment="Top"><TextBlock Text="{Binding Initials}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="SemiBold"/></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Preview}" Foreground="#9DA3BC" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
</ListBox>
<StackPanel Grid.Row="4" Margin="0,12,0,0"><TextBlock x:Name="Connection" Text="Demo · messages stay on this device" Foreground="#B9A9F9" FontSize="11" TextWrapping="Wrap"/><Button Content="Mark current conversation read" Click="MarkRead_Click" HorizontalAlignment="Stretch"/><Button Content="Contacts" Click="Contacts_Click" HorizontalAlignment="Stretch"/><Button Content="Connection &amp; launch settings" Click="Settings_Click" HorizontalAlignment="Stretch" Margin="0,12,0,0"/></StackPanel>
</Grid></Border>
<Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="88"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<Border BorderBrush="#303347" BorderThickness="0,0,0,1" Padding="28,20"><StackPanel><TextBlock x:Name="ChatTitle" Text="Your conversations, together." FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="ChatSubtitle" Text="Choose a conversation to get started" Foreground="#9298B3" FontSize="12" Margin="0,5,0,0"/></StackPanel></Border>
<Border Grid.Row="1" Background="#29273F" Padding="24,9"><TextBlock x:Name="Status" Text="Demo mode — connect your BlueBubbles server to send real messages." Foreground="#C8BDF0" TextWrapping="Wrap" FontSize="12"/></Border>
<ScrollViewer Grid.Row="2" x:Name="MessageScroll" VerticalScrollBarVisibility="Auto"><ItemsControl x:Name="Messages" Margin="30,24"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,16" HorizontalAlignment="{Binding Alignment}" MaxWidth="520"><TextBlock Text="{Binding Sender}" Foreground="#969CB5" FontSize="11" Margin="8,0,8,5"/><Border Background="{Binding Bubble}" CornerRadius="17" Padding="15,11"><StackPanel><TextBlock Text="{Binding Text}" TextWrapping="Wrap"/><ItemsControl ItemsSource="{Binding Attachments}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel><Image Loaded="Photo_Loaded" MaxWidth="360" MaxHeight="260" Stretch="Uniform" Margin="0,8,0,4"/><Button Content="{Binding Name}" Tag="{Binding}" Click="Attachment_Click" HorizontalAlignment="Left" ToolTip="Save attachment"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border><TextBlock Text="{Binding Receipt}" Foreground="#C3B6EE" FontSize="10" HorizontalAlignment="Right" Margin="8,4,8,0"/><TextBlock Text="{Binding Time}" Foreground="#858CA5" FontSize="10" HorizontalAlignment="Right" Margin="8,5,8,0"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer>
<Border Grid.Row="3" Padding="24,12,24,20" BorderBrush="#303347" BorderThickness="0,1,0,0"><StackPanel><TextBlock x:Name="PendingFile" Foreground="#C0AFF9" Margin="8,0,0,8" TextWrapping="Wrap"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Content="+" FontSize="20" Click="Attach_Click" ToolTip="Attach a photo or file"/><TextBox x:Name="Composer" Grid.Column="1" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="140" MinHeight="45" VerticalScrollBarVisibility="Auto" PreviewKeyDown="Composer_KeyDown" ToolTip="Enter to send · Shift+Enter for a new line"/><Button x:Name="Send" Grid.Column="2" Content="Send" Background="#7460C8" Click="Send_Click"/></Grid><TextBlock Text="Enter to send · Shift + Enter for a new line" Foreground="#777F9A" FontSize="10" Margin="54,8,0,0"/></StackPanel></Border>
</Grid>
</Grid>
</Window>
