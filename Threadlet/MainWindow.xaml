<Window x:Class="Threadlet.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Threadlet" Width="1180" Height="800" MinWidth="840" MinHeight="600" Background="#101010" FontFamily="Segoe UI" FontSize="14">
<Grid>
 <Grid.ColumnDefinitions><ColumnDefinition Width="320"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
 <Border Background="#1C1C1E" BorderBrush="#353537" BorderThickness="0,0,1,0">
  <Grid Margin="14,16,14,12">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid Margin="6,0,0,12"><StackPanel Orientation="Horizontal"><TextBlock Text="Messages" FontSize="28" FontWeight="Bold"/><TextBlock x:Name="UnreadCount" FontSize="14" Foreground="#8E8E93" Margin="8,12,0,0"/></StackPanel><Button Content="&#xE70F;" FontFamily="Segoe Fluent Icons" FontSize="19" HorizontalAlignment="Right" Click="NewChat_Click" ToolTip="New message" AutomationProperties.Name="Compose new message"/></Grid>
   <Grid Grid.Row="1" Margin="2,0,2,8"><TextBox x:Name="Search" Height="36" TextChanged="Search_Changed" ToolTip="Search conversations" AutomationProperties.Name="Search conversations"/><TextBlock Text="Search" Foreground="#98989D" Margin="10,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=Search}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></Grid>
   <ItemsControl Grid.Row="2" x:Name="PinnedChats" Margin="0,6,0,6"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Button Tag="{Binding Guid}" Click="Pinned_Click" Padding="2" Width="86" Margin="3"><StackPanel><Border Width="52" Height="52" CornerRadius="26" Background="#636366"><TextBlock Text="{Binding Initials}" FontSize="19" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="{Binding Name}" FontSize="11" TextTrimming="CharacterEllipsis" TextAlignment="Center" Margin="0,6,0,0"/></StackPanel></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
   <Button Grid.Row="3" x:Name="FilterButton" Content="All Messages" Click="Filter_Click" HorizontalAlignment="Left" FontSize="12" Margin="0,0,0,2" ToolTip="Switch between all and unread messages"/>
   <ListBox Grid.Row="4" x:Name="Chats" SelectionChanged="Chat_Selected" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
    <ListBox.ItemTemplate><DataTemplate><Grid>
     <Grid.ContextMenu><ContextMenu><MenuItem Header="{Binding ReadLabel}" Click="ChatRead_Click"/><MenuItem Header="{Binding MuteLabel}" Click="ChatMute_Click"/><MenuItem Header="{Binding PinLabel}" Click="ChatPin_Click"/></ContextMenu></Grid.ContextMenu>
     <Grid.ColumnDefinitions><ColumnDefinition Width="12"/><ColumnDefinition Width="48"/><ColumnDefinition/></Grid.ColumnDefinitions>
     <TextBlock Text="{Binding UnreadDot}" Foreground="#0A84FF" FontSize="11" VerticalAlignment="Center"/>
     <Border Grid.Column="1" Width="40" Height="40" CornerRadius="20" Background="#636366" VerticalAlignment="Top"><TextBlock Text="{Binding Initials}" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
     <StackPanel Grid.Column="2"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Preview}" Foreground="#98989D" TextTrimming="CharacterEllipsis" FontSize="13" Margin="0,5,0,0"/><TextBlock Text="{Binding Indicators}" Foreground="#8E8E93" FontSize="10" Margin="0,3,0,0"/></StackPanel>
    </Grid></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <StackPanel Grid.Row="5" Margin="6,10,6,0"><TextBlock x:Name="Connection" Text="Demo mode" Foreground="#8E8E93" FontSize="11"/><TextBlock x:Name="VmStatus" Text="VM not configured" Foreground="#8E8E93" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,0"/><WrapPanel><Button Content="Contacts" Click="Contacts_Click" FontSize="12" Padding="0,8,12,0"/><Button Content="Settings" Click="Settings_Click" FontSize="12" Padding="0,8,0,0"/></WrapPanel></StackPanel>
  </Grid>
 </Border>
 <Grid Grid.Column="1">
  <Grid.RowDefinitions><RowDefinition Height="100"/><RowDefinition/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Border Background="#19191B" BorderBrush="#353537" BorderThickness="0,0,0,1">
   <Grid><Button Content="&#xE946;" FontFamily="Segoe Fluent Icons" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16" Click="Info_Click" FontSize="19" ToolTip="Conversation details" AutomationProperties.Name="Conversation details"/>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"><Border Width="36" Height="36" CornerRadius="18" Background="#636366" HorizontalAlignment="Center"><TextBlock x:Name="ChatAvatar" Text="T" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="ChatTitle" Text="Messages" TextAlignment="Center" FontWeight="SemiBold" FontSize="14" Margin="0,5,0,0"/><TextBlock x:Name="ChatSubtitle" Text="Choose a conversation" Foreground="#8E8E93" TextAlignment="Center" FontSize="10" Margin="0,2,0,0"/></StackPanel>
   </Grid>
  </Border>
  <ScrollViewer Grid.Row="1" x:Name="MessageScroll" VerticalScrollBarVisibility="Auto">
   <ItemsControl x:Name="Messages" Margin="26,24"><ItemsControl.ItemTemplate><DataTemplate>
    <StackPanel Margin="0,0,0,12" HorizontalAlignment="{Binding Alignment}" MaxWidth="480">
     <StackPanel.ContextMenu><ContextMenu Opened="MessageMenu_Opened"/></StackPanel.ContextMenu>
     <TextBlock Text="{Binding Sender}" Foreground="#8E8E93" FontSize="10" Margin="12,0,12,4"/>
     <Border Background="{Binding Bubble}" CornerRadius="19" Padding="13,9">
      <StackPanel><TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="15" LineHeight="21"/>
       <ItemsControl ItemsSource="{Binding Attachments}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel>
        <TextBlock Tag="PreviewFeedback" Text="Photo preview unavailable - click the photo area to retry" Visibility="Collapsed" TextWrapping="Wrap" FontSize="11" Foreground="#D1D1D6"/><Image MouseLeftButtonUp="Photo_Click" Cursor="Hand" ToolTip="Open photo" Loaded="Photo_Loaded" MaxWidth="340" MaxHeight="250" Stretch="Uniform" Margin="0,6,0,4"/>
        <Button Content="{Binding Name}" Tag="{Binding}" Click="Attachment_Click" HorizontalAlignment="Left" Foreground="White" Padding="0,5" FontSize="11" ToolTip="Save original attachment"/>
       </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      </StackPanel>
     </Border>
     <TextBlock Text="{Binding Receipt}" Foreground="#8E8E93" FontSize="10" HorizontalAlignment="Right" Margin="8,4,8,0"/>
     <TextBlock Text="{Binding Time}" Foreground="#636366" FontSize="10" HorizontalAlignment="Right" Margin="8,3,8,0"/>
    </StackPanel>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </ScrollViewer>
  <Border Grid.Row="2" Padding="20,8,20,12">
   <StackPanel>
    <StackPanel Orientation="Horizontal"><StackPanel.Style><Style TargetType="StackPanel"><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=PendingFile}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></StackPanel.Style><Image x:Name="PendingPreview" MaxWidth="160" MaxHeight="100" Margin="8"/><Button Content="Remove" Click="RemoveAttachment_Click"/></StackPanel>
    <TextBlock x:Name="PendingFile" Foreground="#8E8E93" FontSize="11" Margin="42,0,0,6" TextWrapping="Wrap"/>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Button Content="+" FontSize="24" Click="Attach_Click" Width="36" Height="36" Padding="0" VerticalAlignment="Bottom" ToolTip="Add photo or attachment" AutomationProperties.Name="Add attachment"/>
     <TextBox x:Name="Composer" Grid.Column="1" AcceptsReturn="True" TextWrapping="Wrap" MaxHeight="140" MinHeight="38" Background="#1C1C1E" BorderThickness="1" BorderBrush="#48484A" VerticalScrollBarVisibility="Auto" PreviewKeyDown="Composer_KeyDown" ToolTip="Message - Enter to send, Shift+Enter for a new line" AutomationProperties.Name="Message"/>
     <Button x:Name="Send" Grid.Column="2" Content="&#x2191;" Foreground="White" FontSize="22" FontWeight="Bold" Width="34" Height="34" Padding="0" Background="#0A84FF" VerticalAlignment="Bottom" Margin="8,0,0,2" Click="Send_Click" ToolTip="Send message" AutomationProperties.Name="Send message"/>
    </Grid>
   </StackPanel>
  </Border>
  <TextBlock Grid.Row="3" x:Name="Status" Text="Demo - messages stay on this device" Foreground="#8E8E93" TextWrapping="Wrap" FontSize="10" Margin="62,0,20,10"/>
 </Grid>
</Grid>
</Window>
